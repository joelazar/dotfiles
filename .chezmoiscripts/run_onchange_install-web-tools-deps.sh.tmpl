#!/usr/bin/env bash
# Install npm dependencies for the web-tools pi extension.
# Re-runs whenever package.json changes.
#
# package.json hash: {{ include "dot_pi/agent/extensions/web-tools/package.json" | sha256sum }}

set -euo pipefail

EXT_DIR="{{ .chezmoi.homeDir }}/.pi/agent/extensions/web-tools"

if [ -d "$EXT_DIR" ]; then
    echo "==> Installing web-tools extension dependencies"
    (cd "$EXT_DIR" && npm install --ignore-scripts --omit=dev)
fi
