#!/usr/bin/env bash
# Clone the agent skills repo to ~/.agents/skills, the path agents read global skills from.
# Skills live in joelazar/skills, like the neovim config lives in joelazar/nvim-config.

set -euo pipefail

SKILLS_DIR="{{ .chezmoi.homeDir }}/.agents/skills"

if [ ! -d "$SKILLS_DIR" ]; then
    echo "==> Cloning agent skills repo"
    mkdir -p "$(dirname "$SKILLS_DIR")"
    git clone git@github.com:joelazar/skills.git "$SKILLS_DIR"
fi
