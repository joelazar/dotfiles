#!/usr/bin/env bash
# Teach AgentsView about the extra Claude Code profile directories.
#
# AgentsView only scans ~/.claude/projects by default, so the separate work
# profile in ~/.claude-work is invisible to it. The config file also holds
# generated secrets (auth_token, cursor_secret), so it cannot be managed as a
# plain dotfile: this script only inserts/updates the claude_project_dirs key.
#
# Re-runs whenever the directory list below changes.

set -euo pipefail

CONFIG="{{ .chezmoi.homeDir }}/.agentsview/config.toml"

DIRS=(
    "{{ .chezmoi.homeDir }}/.claude/projects"
    "{{ .chezmoi.homeDir }}/.claude-work/projects"
)

if [ ! -d "{{ .chezmoi.homeDir }}/.agentsview" ]; then
    echo "==> AgentsView not installed, skipping configuration"
    exit 0
fi

# Build the TOML array line, keeping only directories that exist.
entries=()
for dir in "${DIRS[@]}"; do
    [ -d "$dir" ] && entries+=("\"$dir\"")
done

if [ "${#entries[@]}" -eq 0 ]; then
    echo "==> No Claude project directories found, skipping configuration"
    exit 0
fi

joined=$(
    IFS=,
    echo "${entries[*]}"
)
line="claude_project_dirs = [${joined//,/, }]"

touch "$CONFIG"
if grep -q '^claude_project_dirs' "$CONFIG"; then
    tmp=$(mktemp)
    grep -v '^claude_project_dirs' "$CONFIG" >"$tmp"
    mv "$tmp" "$CONFIG"
fi
printf '%s\n' "$line" >>"$CONFIG"
chmod 600 "$CONFIG"

echo "==> AgentsView claude_project_dirs set to: ${entries[*]}"

# Pick up the new config; ignore failures when the daemon is not running.
if command -v agentsview >/dev/null 2>&1; then
    agentsview daemon restart >/dev/null 2>&1 || true
elif [ -x /Applications/AgentsView.app/Contents/MacOS/agentsview ]; then
    /Applications/AgentsView.app/Contents/MacOS/agentsview daemon restart >/dev/null 2>&1 || true
fi
