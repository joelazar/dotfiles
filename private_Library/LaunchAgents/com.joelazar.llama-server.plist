<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent: run llama-server (llama.cpp) in router mode at login.
  pi's built-in llama.cpp provider talks to it (default URL
  http://127.0.0.1:8080, no /login needed). Load/unload/download models
  with /llama, pick them with /model.

  Target hardware: MacBook Pro M4 Pro, 48 GB unified memory.

  Notes:
    - Router mode: no -m/-hf. Models come from ~/models (GGUF files;
      multi-shard/multimodal models in their own subdirectory) and the
      HF cache under ~/Library/Caches/llama.cpp (/llama downloads land here).
    - Flags below apply to every model. Per-model overrides: --models-preset.
    - --models-max 1: one model in memory at a time on 48 GB.
    - Web UI available at http://127.0.0.1:8080

  Manage with the fish functions llama-cpp-{start,stop,restart,status,logs}.
--><plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joelazar.llama-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>

        <!-- Router mode: discover GGUFs here (plus the HF cache). -->
        <string>--models-dir</string>
        <string>/Users/joelazar/models</string>
        <string>--models-max</string>
        <string>1</string>

        <!-- pi's default llama.cpp URL. -->
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>

        <!-- 64K context — 32K fills up fast in an agent loop.
             KV cache at 64K q8_0 ≈ ~6 GB, leaves headroom on 48 GB. -->
        <string>-c</string>
        <string>65536</string>

        <!-- Flash attention: required for KV cache quantization, pure win
             on Metal. -->
        <string>-fa</string>
        <string>on</string>

        <!-- q8_0 KV cache halves its RAM with near-zero quality loss. -->
        <string>-ctk</string>
        <string>q8_0</string>
        <string>-ctv</string>
        <string>q8_0</string>

        <!-- Offload all layers to the GPU (Metal). -->
        <string>-ngl</string>
        <string>99</string>

        <!-- Single parallel request — predictable RAM on 48 GB. -->
        <string>-np</string>
        <string>1</string>

        <!-- Use the model's embedded chat template — proper tool-calling
             and thinking-block parsing. -->
        <string>--jinja</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Ensure the binary finds Homebrew's env. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>

        <!-- Needed so the HF download cache resolves under ~/Library. -->
        <key>HOME</key>
        <string>/Users/joelazar</string>
    </dict>

    <!-- Start at login and keep alive (restart on crash). -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Throttle respawn if it keeps crashing. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/com.joelazar.llama-server.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.joelazar.llama-server.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
