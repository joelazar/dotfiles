// Basic OpenCode v2 setup ported from pi. Backlog: PORTING.md next to this file.
// Generated from ~/.pi/agent/extensions/guardrails.json (secrets deny-list + shell gate).
// Last matching permission rule wins.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "claude-agent/opus",
  "skills": [
    "~/Code/onomondo/.pi/skills"
  ],
