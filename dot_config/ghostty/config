# Ghostty config. Only non-default settings are listed.
# `ghostty +show-config --default --docs` for reference; `ghostty +list-keybinds --default` for keys.

# --- Font & theme ---
font-family = Maple Mono NF
font-feature = +cv02
font-feature = +cv05
font-feature = +cv61
font-feature = +cv63
font-size = 13.0
theme = Catppuccin Mocha

# --- Window ---
maximize = true
window-save-state = always
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = false
window-inherit-font-size = false
working-directory = home
macos-window-buttons = hidden
macos-non-native-fullscreen = visible-menu
macos-option-as-alt = left
quit-after-last-window-closed = true
resize-overlay = never

# --- Terminal behaviour ---
cursor-style-blink = false
mouse-hide-while-typing = true
clipboard-paste-protection = false
scrollback-limit = 100000000
# how long a closed tab/split can be restored with super+z
undo-timeout = 20s
shell-integration-features = sudo,title,ssh-env,no-ssh-terminfo

# Notify when a long-running command finishes in an unfocused surface
# (replaces the fish `done` plugin)
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

# --- Keybinds: tabs & windows ---
# physical: keeps digits working on non-US layouts
keybind = super+physical:one=goto_tab:1
keybind = super+physical:two=goto_tab:2
keybind = super+physical:three=goto_tab:3
keybind = super+physical:four=goto_tab:4
keybind = super+physical:five=goto_tab:5
keybind = super+physical:six=goto_tab:6
keybind = super+physical:seven=goto_tab:7
keybind = super+physical:eight=goto_tab:8
keybind = super+physical:nine=last_tab
keybind = super+shift+t=prompt_tab_title
keybind = super+shift+comma=move_tab:-1
keybind = super+shift+period=move_tab:1
keybind = super+grave_accent=goto_window:next
keybind = super+shift+grave_accent=goto_window:previous

# --- Keybinds: splits ---
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+l=goto_split:right
# resize mode: super+ctrl+r to enter, h/j/k/l to resize, escape to exit
keybind = super+ctrl+r=activate_key_table:resize
keybind = resize/h=resize_split:left,10
keybind = resize/j=resize_split:down,10
keybind = resize/k=resize_split:up,10
keybind = resize/l=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore

# --- Keybinds: scrolling ---
keybind = super+shift+up=scroll_page_lines:-3
keybind = super+shift+down=scroll_page_lines:3
keybind = super+shift+home=scroll_to_top
keybind = super+shift+end=scroll_to_bottom

# --- Keybinds: font ---
keybind = super+plus=increase_font_size:0.5
keybind = super+minus=decrease_font_size:0.5

# --- Keybinds: scrollback ---
# open the full scrollback in the default editor
keybind = super+shift+f=write_scrollback_file:open
keybind = super+alt+shift+j=write_scrollback_file:open,html
keybind = super+shift+j=write_scrollback_file:paste,html

# --- Keybinds: clipboard ---
# these are the defaults, but binding them explicitly keeps cmd+c/cmd+v working
# in native text fields (Change Tab Title dialog, find bar). See ghostty#10749
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# --- Keybinds: selection ---
# performable: only consumed when a selection exists, otherwise passed to the app (yazi uses shift+up/down)
keybind = performable:shift+up=adjust_selection:up
keybind = performable:shift+down=adjust_selection:down
keybind = shift+left=adjust_selection:left
keybind = shift+right=adjust_selection:right

# --- Keybinds: text sent to the shell / TUIs ---
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = shift+enter=text:\n
keybind = ctrl+enter=text:\x1b[13;5u
# cmd+p -> ctrl+p
keybind = super+p=text:\x10
# cmd+r -> <D-r> for nvim (CSI u: 114='r', 9=1+super)
keybind = super+r=text:\x1b[114;9u
# cmd+shift+<x> -> ctrl+shift+<x> (CSI u, 6=1+shift+ctrl) for pi/nvim; overrides
# ghostty's search-nav and reload_config defaults on these keys
keybind = super+shift+g=text:\x1b[103;6u
keybind = super+shift+c=text:\x1b[99;6u
keybind = super+shift+e=text:\x1b[101;6u
keybind = super+shift+m=text:\x1b[109;6u
keybind = super+shift+a=text:\x1b[97;6u
keybind = super+shift+r=text:\x1b[114;6u
