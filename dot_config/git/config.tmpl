[user]
    # Specify the email address of the author/committer.
    email = "{{ .email }}"

    # Specify the username of the author/committer.
    name = "{{ .name }}"

    # Sign commits and tags with the SSH key.
    signingkey = ~/.ssh/id_ed25519.pub

    # Don't guess the user's identity.
    useConfigOnly = true

[alias]

    br       = branch --list --remote
    c        = commit
    co       = checkout
    cp       = cherry-pick
    d        = "!git add -AN 2>/dev/null; git diff"
    dc       = diff --cached
    dn       = "!git add -AN 2>/dev/null; nvim -c ':CodeDiff'"
    f        = fetch --prune
    lg       = log --graph --date=relative --pretty=format:'%C(bold blue)%h%C(reset) - %C(green)(%ar) %C(white)%s %C(dim white) [%an] %C(bold yellow)%d'
    lgall    = log --all --graph --date=relative --pretty=format:'%C(bold blue)%h%C(reset) - %C(green)(%ar) %C(white)%s %C(dim white) [%an] %C(bold yellow)%d'
    p        = pull
    ps       = push
    pushf    = push --force-with-lease
    s        = status
    sub      = submodule update --init --recursive

[mergetool]

    prompt = false
    keepBackup = false

[mergetool "nvim"]

    cmd = nvim -f "$MERGED" -c "CodeDiff merge \"$MERGED\""

[difftool]

    prompt = false

[difftool "nvim"]

    cmd = nvim -f "$LOCAL" "$REMOTE" +"CodeDiff file $LOCAL $REMOTE"

[diff]

    algorithm = histogram
    colorMoved = default
    tool = nvim

[branch]

    sort = -committerdate

[commit]

    gpgsign = true
    verbose = true

[tag]

    gpgsign = true

[gpg]

    format = ssh

[merge]

    conflictstyle = zdiff3
    tool = nvim

[color]

    ui = true

[color "branch"]

    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]

    meta = yellow
    frag = magenta bold
    old = red bold
    new = green bold
    commit = yellow bold
    whitespace = red reverse

[color "status"]

    added = yellow
    changed = green
    untracked = cyan

[color "diff-highlight"]

    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22

[core]

    abbrev = 12
    attributesfile = ~/.gitattributes
    excludesfile = ~/.config/git/ignore
    eol = lf
    autocrlf = false
    fileMode = false
    pager = delta

[pager]

    log = delta
    reflog = delta
    show = delta
    blame = delta
    grep = delta

[interactive]

    diffFilter = delta --color-only

[include]

    path = ~/.config/delta/catppuccin.gitconfig

[delta]

    features = catppuccin-mocha
    syntax-theme = Catppuccin Mocha
    navigate = true
    line-numbers = true
    hunk-header-style = omit
    file-modified-label =
    hyperlinks = true
    true-color = always

[diff "bin"]

    # Use `hexdump` to diff binary files.

    textconv = hexdump -v -C

[push]

    # Make `git push` automatically push relevant
    # annotated tags when pushing branches out.

    autoSetupRemote = true
    default = simple
    followTags = true

[fetch]

    prune = true
    pruneTag = true

[url "git@github.com:"]

    insteadOf = https://github.com/

[pull]

    rebase = false

[filter "lfs"]

    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[credential "https://github.com"]

    helper = !gh auth git-credential

[credential "https://gist.github.com"]

    helper = !gh auth git-credential

[rerere]

    enabled = true

[init]

    defaultBranch = main

[gj]

    root = {{ .gjRoot }}

[includeIf "gitdir:~/Code/onomondo/"]

    path = "~/.config/git/work_config"
