# Default application associations, applied with `duti`.
# Format: <bundle-id> <UTI-or-.extension> <role>
# System source-code types are set by UTI so they override Xcode's claims.

# --- Neovide: text & source code (by UTI) ---
com.neovide.neovide public.plain-text all
com.neovide.neovide public.source-code all
com.neovide.neovide public.script all
com.neovide.neovide public.shell-script all
com.neovide.neovide public.bash-script all
com.neovide.neovide public.zsh-script all
com.neovide.neovide public.python-script all
com.neovide.neovide public.ruby-script all
com.neovide.neovide public.perl-script all
com.neovide.neovide public.php-script all
com.neovide.neovide public.c-source all
com.neovide.neovide public.c-header all
com.neovide.neovide public.c-plus-plus-source all
com.neovide.neovide public.c-plus-plus-header all
com.neovide.neovide public.objective-c-source all
com.neovide.neovide public.objective-c-plus-plus-source all
com.neovide.neovide public.swift-source all
com.neovide.neovide public.assembly-source all
com.neovide.neovide public.make-source all
com.neovide.neovide com.apple.rez-source all
com.neovide.neovide com.netscape.javascript-source all
com.neovide.neovide public.json all
com.neovide.neovide public.yaml all
com.neovide.neovide public.xml all
com.neovide.neovide com.apple.property-list all
com.neovide.neovide public.comma-separated-values-text all

# --- Neovide: text & config (by extension) ---
com.neovide.neovide .md all
com.neovide.neovide .markdown all
com.neovide.neovide .mdx all
com.neovide.neovide .log all
com.neovide.neovide .jsonc all
com.neovide.neovide .toml all
com.neovide.neovide .ini all
com.neovide.neovide .conf all
com.neovide.neovide .cfg all
com.neovide.neovide .tsv all
com.neovide.neovide .env all
com.neovide.neovide .patch all
com.neovide.neovide .diff all
com.neovide.neovide .fish all
com.neovide.neovide .command all
com.neovide.neovide .lua all
com.neovide.neovide .go all
com.neovide.neovide .rs all
com.neovide.neovide .kt all
com.neovide.neovide .kts all
com.neovide.neovide .scala all
com.neovide.neovide .jsx all
com.neovide.neovide .ts all
com.neovide.neovide .tsx all
com.neovide.neovide .vue all
com.neovide.neovide .svelte all
com.neovide.neovide .scss all
com.neovide.neovide .sass all
com.neovide.neovide .less all
com.neovide.neovide .sql all
com.neovide.neovide .gradle all
com.neovide.neovide .pm all
com.neovide.neovide .jl all
com.neovide.neovide .dart all
com.neovide.neovide .ex all
com.neovide.neovide .exs all
com.neovide.neovide .erl all
com.neovide.neovide .hs all
com.neovide.neovide .clj all
com.neovide.neovide .tf all
com.neovide.neovide .hcl all
com.neovide.neovide .proto all
com.neovide.neovide .graphql all
com.neovide.neovide .gql all
com.neovide.neovide .properties all
com.neovide.neovide .tex all
com.neovide.neovide .bib all

# --- Ghostty: run executable scripts ---
# Executable files are public.unix-executable and use the special "shell" role,
# which Terminal.app claims by default. Ghostty declares the same role, so
# double-clicking a script runs it in Ghostty instead of Terminal.
com.mitchellh.ghostty public.unix-executable shell

# --- IINA: video (by extension) ---
com.colliderli.iina .mp4 all
com.colliderli.iina .mkv all
com.colliderli.iina .avi all
com.colliderli.iina .mov all
com.colliderli.iina .wmv all
com.colliderli.iina .flv all
com.colliderli.iina .webm all
com.colliderli.iina .m4v all
com.colliderli.iina .mpg all
com.colliderli.iina .mpeg all
com.colliderli.iina .3gp all
com.colliderli.iina .vob all
com.colliderli.iina .ogv all
com.colliderli.iina .rmvb all
