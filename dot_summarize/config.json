{
  "cli": {
    "enabled": [
      "pi",
      "claude",
      "agy"
    ],
    "autoFallback": {
      "enabled": true,
      "onlyWhenNoApiKeys": true,
      "order": [
        "pi",
        "claude",
        "agy"
      ]
    },
    "claude": {
      "model": "haiku",
      "extraArgs": [
        "--verbose"
      ]
    },
    "agy": {},
    "pi": {
      "extraArgs": [
        "--provider",
        "anthropic",
        "--model",
        "claude-haiku-5-5"
      ]
    }
  }
}
