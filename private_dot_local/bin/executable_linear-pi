#!/usr/bin/env bash
# Linear "Work on issue → Custom script" handler: open the issue in a Rex
# session and start pi with Linear's prompt. Needs the Rex app running.
# Git repo: worktree via `git wt <branch>`. Otherwise: workDir as-is.
# Wired up in ~/.linear/coding-tools.json.
#
# Usage: linear-pi <workDir> <branch> <identifier>   (prompt via LINEAR_PROMPT)
set -euo pipefail

# Rex only puts `rex` on PATH inside its own terminals.
REX_BIN_DIR="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS"
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH:$REX_BIN_DIR"
LOG="${TMPDIR:-/tmp}/linear-pi.log"
exec 2>>"$LOG"

die() {
    printf 'linear-pi: %s\n' "$1" >&2
    osascript -e "display notification \"$1\" with title \"linear-pi\"" >/dev/null 2>&1 || true
    exit 1
}

use_rex() {
    pgrep -x Rex >/dev/null 2>&1 && command -v rex >/dev/null 2>&1
}

# Show the Rex session labelled <id>, or create it in <dir> running pi.
# pi runs under `fish -c` so the tab drops to a shell when pi exits.
open_rex() {
    local dir="$1" id="$2" list sid out client
    list="$(rex ls --json)" || die "rex ls failed"
    sid="$(jq -r --arg l "$id" '.sessions[] | select(.label == $l) | .session_id' <<<"$list" | head -n1)"
    if [[ -z $sid ]]; then
        # shellcheck disable=SC2016 # $argv is expanded by fish
        out="$(rex new "$id" -c "$dir" --json -- fish -c 'pi $argv; exec fish' "${LINEAR_PROMPT:-Work on Linear issue $id}" 2>&1)" ||
            die "rex new failed: $out"
        sid="$(jq -r '.session_id // empty' <<<"$out")"
    fi
    client="$(rex client ls --json | jq -r '.clients[] | select(.info.kind == "app") | .client_id' | head -n1)"
    if [[ -n $sid && -n $client ]]; then
        rex -C "$client" "do" session.select session_id="$sid" >/dev/null || true
    fi
    open -a "Rex Beta"
}

main() {
    [[ $# -eq 3 ]] || die "usage: linear-pi <workDir> <branch> <identifier>"
    local dir="${1/#\~/$HOME}" branch="$2" id="$3"
    [[ -d $dir ]] || die "not a directory: $dir"

    if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
        dir="$(cd "$dir" && git wt "$branch" 2>&1)" || die "git wt failed: $dir"
    fi

    use_rex || die "Rex is not running"
    open_rex "$dir" "$id"
}

main "$@"
