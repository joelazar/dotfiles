#!/bin/bash
SOURCE_DIR=$(chezmoi source-path)

. "$SOURCE_DIR/scripts/utils_install" &&
    . "$SOURCE_DIR/scripts/utils"

echo "🧑‍💻 Updating Claude Code"
brew upgrade claude-code@latest
echo

echo "🚀 Update Codex"
brew upgrade codex
echo

echo "🌐 Update Antigravity-cli"
brew upgrade antigravity-cli
echo

echo "🥧 Update Pi"
pi update --all
pi update --models
echo
