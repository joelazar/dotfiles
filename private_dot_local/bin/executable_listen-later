#!/usr/bin/env bash
# listen-later — turn an article, file, or pasted text into a Kokoro-narrated
# private episode in the "📥 Listen Later" Spotify show.
#
# Usage:
#   listen-later [options] <url|file> [url|file ...]
#   pbpaste | listen-later [options]
#
# Options:
#   -t, --title <title>   Episode title (default: derived from source)
#   -v, --voice <voice>   Kokoro voice (default: af_heart)
#   -s, --speed <n>       Speech speed multiplier (default: 1.0)
#   -S, --summarize       Summarize the content with pi before narrating
#       --minutes <n>     Target length in minutes for --summarize (default: 4)
#       --show <name>     Target show (default: "📥 Listen Later")
#       --wait            Poll until the episode is READY before exiting
#       --jobs <n>        Parallel Kokoro workers (default: min(4, ncpu))
#       --keep            Keep the work directory after success
#   -h, --help            Show this help
#
# Without --summarize, narrates the full cleaned text verbatim. With
# --summarize, pi condenses the source to a spoken-word summary first.
# URLs and .html files go through trafilatura (article text + title, author,
# date, og:image). Chapters come from the article's headings, else pi titles them.

set -euo pipefail

source "${HOME}/.local/share/chezmoi/scripts/utils" 2>/dev/null || {
    cmd_exists() { command -v "$1" >/dev/null 2>&1; }
}

die() {
    printf '\033[31merror:\033[0m %s\n' "$*" >&2
    exit 1
}
info() { printf '\033[36m==>\033[0m %s\n' "$*" >&2; }

VOICE="af_heart"
SPEED="1.0"
SHOW_NAME="📥 Listen Later"
TITLE=""
WAIT=0
KEEP=0
SUMMARIZE=0
MINUTES=4
INNER_MS=300
OUTER_MS=600
WPM=150
NCPU=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
JOBS=$((NCPU > 4 ? 4 : NCPU))
SOURCES=()

while [[ $# -gt 0 ]]; do
    case "$1" in
    -t | --title)
        TITLE="$2"
        shift 2
        ;;
    -v | --voice)
        VOICE="$2"
        shift 2
        ;;
    -s | --speed)
        SPEED="$2"
        shift 2
        ;;
    -S | --summarize)
        SUMMARIZE=1
        shift
        ;;
    --minutes)
        MINUTES="$2"
        shift 2
        ;;
    --show)
        SHOW_NAME="$2"
        shift 2
        ;;
    --wait)
        WAIT=1
        shift
        ;;
    --jobs)
        JOBS="$2"
        shift 2
        ;;
    --keep)
        KEEP=1
        shift
        ;;
    -h | --help)
        sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
        exit 0
        ;;
    -*) die "Unknown option: $1" ;;
    *)
        SOURCES+=("$1")
        shift
        ;;
    esac
done

for bin in kokoro ffmpeg ffprobe jq save-to-spotify uv curl; do
    cmd_exists "$bin" || die "$bin is required but not on PATH"
done

AUTH=$(save-to-spotify --json auth status 2>/dev/null || true)
[[ "$(echo "$AUTH" | jq -r '.authenticated // false')" == "true" ]] ||
    die "not authenticated — run: save-to-spotify auth login"

info "Resolving show: $SHOW_NAME"
SHOW_URI=$(save-to-spotify --json shows |
    jq -r --arg t "$SHOW_NAME" '.shows[] | select(.title == $t) | .show_uri' |
    head -n1)
[[ -n "$SHOW_URI" ]] || die "show not found: $SHOW_NAME (create it once with save-to-spotify shows create)"

slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-60; }

if [[ ${#SOURCES[@]} -eq 0 ]]; then
    SOURCES=("-")
fi
if [[ ${#SOURCES[@]} -gt 1 && -n "$TITLE" ]]; then
    die "--title can only be used with a single source"
fi

WORKDIRS=()
cleanup() { [[ "$KEEP" -eq 1 || ${#WORKDIRS[@]} -eq 0 ]] || rm -rf "${WORKDIRS[@]}"; }
trap cleanup EXIT

extract_html() { # <html file> <url or ""> <work dir>
    cat >"$3/extract.py" <<'PY'
# /// script
# requires-python = ">=3.10"
# dependencies = ["trafilatura"]
# ///
import html, json, re, sys
from pathlib import Path
import trafilatura

src, url, work = sys.argv[1], sys.argv[2] or None, Path(sys.argv[3])
raw = Path(src).read_text(encoding="utf-8", errors="replace")
text = trafilatura.extract(
    raw, url=url, output_format="markdown", include_formatting=True,
    include_comments=False, include_tables=False, include_images=False,
    include_links=False) or trafilatura.html2txt(raw) or ""
m = trafilatura.extract_metadata(raw, default_url=url)
meta = m.as_dict() if m else {}

def norm(v):
    return re.sub(r"\s+", " ", html.unescape(v or "")).strip()

title = norm(meta.get("title"))
for suffix in (norm(meta.get("sitename")), norm(meta.get("hostname"))):
    if suffix:
        title = re.sub(rf"\s+[|·–—-]\s+{re.escape(suffix)}$", "", title, flags=re.I)

# Drop a trailing "More articles"-style section: a heading followed only by link lists.
blocks = re.split(r"\n\s*\n", text.strip())
heads = [i for i, b in enumerate(blocks) if b.lstrip().startswith("#")]
if heads and heads[-1] > 0 and blocks[heads[-1] + 1:] and all(
        re.match(r"^\s*([-*+]|\d+\.)\s", ln) for b in blocks[heads[-1] + 1:]
        for ln in b.splitlines() if ln.strip()):
    blocks = blocks[:heads[-1]]

(work / "raw.txt").write_text("\n\n".join(blocks), encoding="utf-8")
(work / "source.json").write_text(json.dumps({
    "title": title, "author": norm(meta.get("author")), "date": meta.get("date") or "",
    "sitename": norm(meta.get("sitename")), "image": meta.get("image") or "",
}), encoding="utf-8")
PY
    uv run --quiet "$3/extract.py" "$1" "$2" "$3"
}

process_source() {
    local SOURCE="$1" EP_TITLE="$TITLE" SRC_URL="" WORK
    mkdir -p /tmp/listen-later
    WORK=$(mktemp -d /tmp/listen-later/XXXXXX)
    WORKDIRS+=("$WORK")

    if [[ "$SOURCE" == "-" ]]; then
        [[ -t 0 ]] && die "no input — pass a url/file or pipe text on stdin"
        cat >"$WORK/raw.txt"
        [[ -n "$EP_TITLE" ]] || EP_TITLE="Listen Later $(date +%Y-%m-%d)"
    elif [[ "$SOURCE" =~ ^https?:// ]]; then
        info "Fetching: $SOURCE"
        curl -fsSL --max-time 60 -o "$WORK/source.html" "$SOURCE" || die "failed to fetch $SOURCE"
        SRC_URL="$SOURCE"
        extract_html "$WORK/source.html" "$SRC_URL" "$WORK" || die "failed to extract text"
        [[ -n "$EP_TITLE" ]] || EP_TITLE=$(jq -r .title "$WORK/source.json")
        [[ -n "$EP_TITLE" ]] || EP_TITLE=$(slugify "$SOURCE" | tr '-' ' ')
    elif [[ -f "$SOURCE" ]]; then
        info "Reading file: $SOURCE"
        case "$SOURCE" in
        *.html | *.htm)
            extract_html "$SOURCE" "" "$WORK" || die "failed to extract text"
            [[ -n "$EP_TITLE" ]] || EP_TITLE=$(jq -r .title "$WORK/source.json")
            ;;
        *) cp "$SOURCE" "$WORK/raw.txt" ;;
        esac
        [[ -n "$EP_TITLE" ]] || EP_TITLE=$(basename "${SOURCE%.*}" | tr '_-' '  ')
    else
        die "source is neither a URL nor an existing file: $SOURCE"
    fi

    [[ -n "$(tr -d '[:space:]' <"$WORK/raw.txt")" ]] || die "extracted text is empty"
    info "Title: $EP_TITLE"
    [[ "$KEEP" -eq 1 ]] && info "Work dir: $WORK"

    if [[ "$SUMMARIZE" -eq 1 ]]; then
        cmd_exists pi-oneshot || die "pi-oneshot is required for --summarize but not on PATH"
        WORDS=$((MINUTES * WPM))
        info "Summarizing with pi (~$MINUTES min / ~$WORDS words)"
        SUM_SYS="You are an editor preparing text for text-to-speech narration. Output ONLY the narration, no preamble, lists, emojis, or URLs. Start each topic with a heading line '## <Title>' of 2 to 5 words, then a blank line, then the paragraph. Write plain declarative sentences. Expand abbreviations and symbols into words."
        SUM_MSG="Condense the attached text into a spoken-word summary of about $WORDS words. Preserve the source's structure and key points in order. Group it into 4 to 10 short paragraphs, each a coherent topic with its own heading."
        pi-oneshot --no-tools --mode json \
            --system-prompt "$SUM_SYS" "$SUM_MSG" @"$WORK/raw.txt" 2>/dev/null |
            jq -rs 'map(select(.type=="agent_end"))[-1].messages[-1].content[] | select(.type=="text") | .text' \
                >"$WORK/summary.txt"
        [[ -s "$WORK/summary.txt" ]] || die "summarization produced no output"
        mv "$WORK/summary.txt" "$WORK/raw.txt"
    fi

    cat >"$WORK/prep.py" <<'PY'
import json, re, sys
from pathlib import Path

work = Path(sys.argv[1]); wpm = int(sys.argv[2])
text = (work / "raw.txt").read_text(encoding="utf-8")

ABBR = {
    "e.g.": "for example", "i.e.": "that is", "etc.": "and so on",
    "vs.": "versus", "Dr.": "Doctor", "Mr.": "Mister", "Mrs.": "Misses",
    "Ms.": "Miss", "Prof.": "Professor", "approx.": "approximately",
    "&": "and",
}
EMOJI = re.compile(
    "[\U0001F000-\U0001FAFF\U00002600-\U000027BF\U0001F1E6-\U0001F1FF\u2190-\u21FF\u2300-\u23FF]",
    flags=re.UNICODE,
)

def clean(s: str) -> str:
    s = s.translate({0x2014: "-", 0x2013: "-", 0x2018: "'", 0x2019: "'",
                     0x201C: '"', 0x201D: '"', 0x2026: "..."})
    s = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", s)
    s = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", s)
    s = re.sub(r"https?://\S+", "", s)
    s = re.sub(r"^[>#\s]*#+\s*", "", s, flags=re.MULTILINE)
    s = re.sub(r"^\s*[-*+]\s+", "", s, flags=re.MULTILINE)
    s = re.sub(r"[`*_>]", "", s)
    s = EMOJI.sub("", s)
    for k, v in ABBR.items():
        s = s.replace(k, v)
    s = s.replace("%", " percent")
    s = re.sub(r"[ \t]+", " ", s)
    return s.strip()

HEAD = re.compile(r"^\s*#{1,6}\s+(.+?)\s*#*\s*$")
paras: list[tuple[str | None, str]] = []  # (heading that starts this para, text)
pending = None
for block in re.split(r"\n\s*\n", text):
    lines = block.strip().splitlines()
    if lines and (m := HEAD.match(lines[0])):
        pending = clean(m.group(1))[:80] or None
        block = "\n".join(lines[1:])
    p = clean(block)
    if len(p.split()) < 3:
        continue
    if pending:  # still narrate the heading, as its own sentence
        p = f"{pending.rstrip('.:!?')}. {p}"
    paras.append((pending, p))
    pending = None

target, hi = wpm * 45 // 60, wpm * 70 // 60
sents = re.compile(r"(?<=[.!?])\s+")

chunks: list[tuple[str | None, str]] = []
for head, p in paras:
    if len(p.split()) <= hi:
        chunks.append((head, p)); continue
    buf: list[str] = []
    for sent in sents.split(p):
        buf.append(sent)
        if sum(len(b.split()) for b in buf) >= target:
            chunks.append((head, " ".join(buf))); buf = []; head = None
    if buf:
        chunks.append((head, " ".join(buf)))

segments: list[list] = []  # [heading, text]
for head, c in chunks:
    if segments and not head and len(segments[-1][1].split()) + len(c.split()) <= hi:
        segments[-1][1] += " " + c
    else:
        segments.append([head, c])

if not segments:
    sys.exit("no narratable segments after cleaning")

meta = {"segments": []}
for i, (head, seg) in enumerate(segments):
    (work / f"seg_{i:03d}.txt").write_text(seg, encoding="utf-8")
    meta["segments"].append({"index": i, "heading": head})
(work / "meta.json").write_text(json.dumps(meta), encoding="utf-8")
print(len(segments))
PY

    NSEG=$(python3 "$WORK/prep.py" "$WORK" "$WPM")
    info "Segments: $NSEG"

    info "Rendering with Kokoro (voice=$VOICE speed=$SPEED)"
    # One process, model loaded per worker, CPU threads split between workers.
    kokoro --voice "$VOICE" --speed "$SPEED" --jobs "$JOBS" "$WORK"/seg_*.txt \
        2>"$WORK/kokoro.log" || true

    MISSING=0
    for txt in "$WORK"/seg_*.txt; do
        wav="${txt%.txt}.wav"
        if [[ ! -s "$wav" ]]; then
            MISSING=$((MISSING + 1))
            printf '\033[31mfailed:\033[0m %s\n' "$(basename "$txt")" >&2
        fi
    done
    [[ "$MISSING" -eq 0 ]] || tail -n 10 "$WORK/kokoro.log" >&2
    [[ "$MISSING" -eq 0 ]] || die "$MISSING segment(s) failed to render (see logs above; rerun with --keep to inspect $WORK)"

    FIRST_WAV=$(ls "$WORK"/seg_*.wav | head -n1)
    SR=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of csv=p=0 "$FIRST_WAV")
    ffmpeg -hide_banner -loglevel error -y -f lavfi -i "anullsrc=r=$SR:cl=mono" -t "$(awk "BEGIN{print $INNER_MS/1000}")" "$WORK/inner.wav"
    ffmpeg -hide_banner -loglevel error -y -f lavfi -i "anullsrc=r=$SR:cl=mono" -t "$(awk "BEGIN{print $OUTER_MS/1000}")" "$WORK/outer.wav"

    CONCAT="$WORK/concat.txt"
    : >"$CONCAT"
    echo "file 'outer.wav'" >>"$CONCAT"
    i=0
    for wav in "$WORK"/seg_*.wav; do
        [[ $i -gt 0 ]] && echo "file 'inner.wav'" >>"$CONCAT"
        echo "file '$(basename "$wav")'" >>"$CONCAT"
        i=$((i + 1))
    done
    echo "file 'outer.wav'" >>"$CONCAT"

    info "Assembling episode.mp3"
    (cd "$WORK" && ffmpeg -hide_banner -loglevel error -y -f concat -safe 0 -i concat.txt \
        -af loudnorm -ar 44100 -ac 1 -b:a 192k episode.mp3)

    cat >"$WORK/cover.py" <<'PY'
# /// script
# requires-python = ">=3.10"
# dependencies = ["pillow"]
# ///
import sys, textwrap
from PIL import Image, ImageDraw, ImageFont
title, out = sys.argv[1], sys.argv[2]
size = 1400
img = Image.new("RGB", (size, size), (30, 30, 46))
d = ImageDraw.Draw(img)
def font(sz):
    for p in ("/System/Library/Fonts/Supplemental/Arial Bold.ttf",
              "/System/Library/Fonts/Helvetica.ttc",
              "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"):
        try:
            return ImageFont.truetype(p, sz)
        except OSError:
            continue
    return ImageFont.load_default()
d.rectangle([0, size - 120, size, size], fill=(203, 166, 247))
big, small = font(96), font(44)
lines = textwrap.wrap(title, width=16)[:6]
total = len(lines) * 120
y = (size - 120 - total) // 2
for ln in lines:
    w = d.textbbox((0, 0), ln, font=big)[2]
    d.text(((size - w) // 2, y), ln, font=big, fill=(205, 214, 244))
    y += 120
foot = "LISTEN LATER"
w = d.textbbox((0, 0), foot, font=small)[2]
d.text(((size - w) // 2, size - 88), foot, font=small, fill=(30, 30, 46))
img.save(out, "JPEG", quality=85)
if len(sys.argv) > 4:  # og:image -> timeline jpg under Spotify's 1 MB limit
    try:
        og = Image.open(sys.argv[3]).convert("RGB")
        og.thumbnail((1280, 1280))
        og.save(sys.argv[4], "JPEG", quality=85)
    except Exception as e:  # noqa: BLE001 - og:image is optional
        print(f"skipping og:image: {e}", file=sys.stderr)
PY

    info "Generating cover"
    OG_ARGS=()
    OG_URL=$([[ -f "$WORK/source.json" ]] && jq -r '.image // ""' "$WORK/source.json" || true)
    if [[ "$OG_URL" =~ ^https?:// ]] && curl -fsSL --max-time 30 -o "$WORK/og.src" "$OG_URL"; then
        OG_ARGS=("$WORK/og.src" "$WORK/og.jpg")
    fi
    uv run --quiet "$WORK/cover.py" "$EP_TITLE" "$WORK/cover.jpg" "${OG_ARGS[@]}"

    cat >"$WORK/build.py" <<'PY'
import html, json, re, subprocess, sys
from pathlib import Path

work = Path(sys.argv[1])
inner_ms, outer_ms = int(sys.argv[2]), int(sys.argv[3])
title, src_url = sys.argv[4], sys.argv[5]
meta = json.loads((work / "meta.json").read_text())
src = json.loads((work / "source.json").read_text()) if (work / "source.json").exists() else {}

def dur_ms(path: Path) -> int:
    out = subprocess.check_output(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "csv=p=0", str(path)]).decode().strip()
    return round(float(out) * 1000)

cursor = outer_ms
segs = []
for s in meta["segments"]:
    d = dur_ms(work / f"seg_{s['index']:03d}.wav")
    segs.append({**s, "start": cursor, "dur": d})
    cursor += d + inner_ms
total = cursor - inner_ms + outer_ms

def seg_text(s) -> str:
    return (work / f"seg_{s['index']:03d}.txt").read_text(encoding="utf-8")

def first_words(text: str) -> str:
    t = " ".join(re.sub(r"[^\w\s'-]", "", text).split()[:6])
    return (t[:1].upper() + t[1:]) if t else "Section"

def pi_titles(texts: list[str]) -> list[str] | None:
    body = "\n---\n".join(t[:1500] for t in texts)
    try:
        out = subprocess.run(
            ["pi-oneshot", "--no-tools", "--system-prompt",
             "You write podcast chapter titles. Output exactly one title of 2 to 5 words "
             "per section, one per line, in order, nothing else.",
             f"Title each of these {len(texts)} sections (separated by ---):\n\n{body}"],
            capture_output=True, text=True, timeout=180).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    lines = [re.sub(r"^\s*(\d+[.)]|[-*])\s+", "", l).strip().strip('"') for l in out.splitlines()]
    lines = [l for l in lines if l]
    return lines if len(lines) == len(texts) else None

chapters = []
heads = [s for s in segs if s["heading"]]
if len(heads) >= 2:
    if not segs[0]["heading"]:
        chapters.append({"title": "Introduction", "start_time_ms": 0})
    chapters += [{"title": s["heading"], "start_time_ms": s["start"]} for s in heads]
elif len(segs) >= 2:
    # ~10 chapters max, at least a minute each.
    min_dur = max(60000, total // 10)
    groups, cur, acc = [], [], 0
    for s in segs:
        cur.append(s); acc += s["dur"]
        if acc >= min_dur:
            groups.append(cur); cur, acc = [], 0
    if cur:
        groups[-1:] = [groups[-1] + cur] if groups else [cur]
    if len(groups) < 2:
        groups = [segs[:len(segs) // 2], segs[len(segs) // 2:]]
    texts = [" ".join(seg_text(s) for s in g) for g in groups]
    names = pi_titles(texts) or [first_words(t) for t in texts]
    chapters = [{"title": n[:80], "start_time_ms": g[0]["start"]} for n, g in zip(names, groups)]

if chapters:
    chapters[0]["start_time_ms"] = 0
    kept = [chapters[0]]
    for c in chapters[1:]:  # Spotify wants >= 5s between chapter starts
        if c["start_time_ms"] - kept[-1]["start_time_ms"] >= 5000:
            kept.append(c)
    chapters = kept if len(kept) >= 2 else []

items = [{"chapter": c} for c in chapters]
companion_ms = min(60000, total)
if (work / "og.jpg").exists():
    img = {"start_time_ms": 0, "duration_ms": companion_ms,
           "image": str(work / "og.jpg"), "title": title}
    if src_url:
        img["url"] = src_url
    items.append({"image": img})
elif src_url:
    items.append({"link": {"start_time_ms": 0, "duration_ms": companion_ms, "url": src_url}})
(work / "timeline.json").write_text(json.dumps({"items": items}), encoding="utf-8")

def mmss(ms: int) -> str:
    s = ms // 1000
    return f"{s // 60}:{s % 60:02d}"

e = html.escape
byline = " · ".join(e(v) for v in (src.get("author"), src.get("sitename"), src.get("date")) if v)
li = "".join(f"<li>{mmss(c['start_time_ms'])} — {e(c['title'])}</li>" for c in chapters)
out = f"<p>{e(title)}, narrated for later listening.</p>"
out += f"<p>{byline}</p>" if byline else ""
out += f"<ul>{li}</ul>" if li else ""
out += f'<p>Source: <a href="{e(src_url)}">{e(src_url)}</a></p>' if src_url else ""
(work / "description.html").write_text(out, encoding="utf-8")
print(len(chapters))
PY

    info "Building chapters and description"
    NCH=$(python3 "$WORK/build.py" "$WORK" "$INNER_MS" "$OUTER_MS" "$EP_TITLE" "$SRC_URL")
    info "Chapters: $NCH"

    info "Uploading episode"
    RESULT=$(save-to-spotify --json --timeout 5m episodes create \
        --show-id "$SHOW_URI" \
        --title "$EP_TITLE" \
        --file "$WORK/episode.mp3" \
        --image "$WORK/cover.jpg" \
        --summary "$(cat "$WORK/description.html")" \
        --language en)

    if echo "$RESULT" | jq -e .error >/dev/null 2>&1; then
        die "upload failed: $(echo "$RESULT" | jq -r .error)"
    fi
    EP_URI=$(echo "$RESULT" | jq -r .episode_uri)
    EP_ID=${EP_URI#spotify:episode:}
    info "Episode: $EP_URI"

    if [[ "$(jq '.items | length' "$WORK/timeline.json")" -gt 0 ]]; then
        info "Setting timeline"
        if ! save-to-spotify --json timeline set --show-id "$SHOW_URI" --episode-id "$EP_ID" \
            --from-file "$WORK/timeline.json" >"$WORK/timeline.out" 2>&1; then
            printf '\033[33mwarn:\033[0m timeline rejected, retrying with chapters only: %s\n' \
                "$(tail -n 1 "$WORK/timeline.out")" >&2
            jq '{items: [.items[] | select(.chapter)]}' "$WORK/timeline.json" >"$WORK/chapters.json"
            [[ "$(jq '.items | length' "$WORK/chapters.json")" -eq 0 ]] ||
                save-to-spotify --json timeline set --show-id "$SHOW_URI" --episode-id "$EP_ID" \
                    --from-file "$WORK/chapters.json" >/dev/null ||
                printf '\033[33mwarn:\033[0m chapters rejected too\n' >&2
        fi
    fi

    if [[ "$WAIT" -eq 1 ]]; then
        info "Waiting for processing"
        STATUS=""
        for _ in $(seq 80); do # 80 x 15s = 20 min cap
            STATUS=$(save-to-spotify --json episodes status "$EP_ID" | jq -r .readiness)
            [[ "$STATUS" == "READY" || "$STATUS" == "FAILED" ]] && break
            sleep 15
        done
        [[ "$STATUS" == "FAILED" ]] && die "processing failed"
        [[ "$STATUS" == "READY" ]] || die "still $STATUS after 20 min: $EP_URI"
        info "Ready"
    fi

    printf '\033[32m✓\033[0m %s\n' "$EP_URI"
}

for SOURCE in "${SOURCES[@]}"; do
    process_source "$SOURCE"
done
