#!/usr/bin/env bash
# Create a herdr tab right after the focused one instead of at the end.
# herdr has no setting for this; tab.create always appends, so we follow it
# with tab.move over the socket API.
set -euo pipefail

die() {
	printf 'herdr-new-tab-adjacent: %s\n' "$1" >&2
	exit 1
}

resolve_herdr_bin() {
	if [[ -n "${HERDR_BIN_PATH:-}" && -x "${HERDR_BIN_PATH}" ]]; then
		printf '%s\n' "$HERDR_BIN_PATH"
	elif command -v herdr >/dev/null 2>&1; then
		command -v herdr
	elif [[ -x /opt/homebrew/bin/herdr ]]; then
		printf '%s\n' /opt/homebrew/bin/herdr
	else
		die "herdr binary not found"
	fi
}

create_adjacent_tab() {
	local herdr_bin socket ws_args=() cwd_args=() list focused_index created new_id

	herdr_bin="$(resolve_herdr_bin)"
	socket="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
	[[ -S "$socket" ]] || die "socket not found: $socket"

	[[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]] && ws_args=(--workspace "$HERDR_ACTIVE_WORKSPACE_ID")
	[[ -n "${HERDR_ACTIVE_PANE_CWD:-}" ]] && cwd_args=(--cwd "$HERDR_ACTIVE_PANE_CWD")

	list="$("$herdr_bin" tab list "${ws_args[@]}")"
	focused_index="$(jq -r '.result.tabs | map(.focused) | index(true) // empty' <<<"$list")"

	created="$("$herdr_bin" tab create "${ws_args[@]}" "${cwd_args[@]}" --focus)"
	new_id="$(jq -r '.result.tab.tab_id' <<<"$created")"

	# No focused tab found: leave the new tab at the end.
	[[ -n "$focused_index" ]] || exit 0

	jq -cn --arg id "$new_id" --argjson idx "$((focused_index + 1))" \
		'{id: "new-tab-adjacent", method: "tab.move", params: {tab_id: $id, insert_index: $idx}}' |
		nc -U -w 2 "$socket" >/dev/null
}

create_adjacent_tab
