#!/usr/bin/env bash
# transcribe — transcribe an audio file locally with Hex (Orukeet model)
#
# Usage:
#   transcribe [-l <lang>] [-m <model>] [--md | -o <file.md>] <file.m4a|file.wav|...>
#
# Options:
#   -l, --language <code>  Language, e.g. hu, en (asked with gum if omitted)
#   -m, --model <id>       Hex model id (default: orukeet)
#       --md               Also write markdown next to the input (<name>.md)
#   -o, --output <file>    Also write markdown to this path
#   -h, --help             Show this help
#
# The transcript is always printed to stdout.
# Non-WAV input is converted to 16 kHz mono WAV with ffmpeg first.
# Requires Labs › Transcribe files (labs.transcribe_files) to be enabled.

set -euo pipefail

# shellcheck disable=SC1091
source "${HOME}/.local/share/chezmoi/scripts/utils" 2>/dev/null || {
    cmd_exists() { command -v "$1" >/dev/null 2>&1; }
}

HEX="/Applications/Hex.app/Contents/MacOS/hex"

die() {
    printf '\033[31merror:\033[0m %s\n' "$*" >&2
    exit 1
}

info() { printf '\033[36m==>\033[0m %s\n' "$*" >&2; }

show_help() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

ensure_hex_running() {
    "$HEX" status >/dev/null 2>&1 || "$HEX" start >/dev/null
}

ask_language() {
    [[ -t 0 && -t 2 ]] || die "No language given and no terminal to ask; pass -l <code>"
    if cmd_exists gum; then
        gum choose --header "Language?" hu en
    else
        local answer
        read -r -p "Language [hu/en]: " answer
        echo "${answer:-hu}"
    fi
}

convert_to_wav() {
    local input="$1" output="$2"
    cmd_exists ffmpeg || die "ffmpeg is required (brew install ffmpeg)"
    ffmpeg -hide_banner -loglevel error -y -i "$input" -ac 1 -ar 16000 -c:a pcm_s16le "$output"
}

write_markdown() {
    local output="$1" transcript="$2"
    mkdir -p "$(dirname "$output")"
    {
        printf '# %s\n\n' "$(basename "${INPUT%.*}")"
        # shellcheck disable=SC2016 # literal markdown backticks
        printf -- '- Source: `%s`\n' "$(basename "$INPUT")"
        printf -- '- Date: %s\n' "$(date '+%Y-%m-%d %H:%M')"
        printf -- '- Language: %s\n' "$LANGUAGE"
        printf -- '- Model: %s\n\n' "$MODEL"
        printf '%s\n' "$transcript"
    } >"$output"
    info "Wrote $output"
}

LANGUAGE=""
MODEL="orukeet"
INPUT=""
MD_OUTPUT=""
MD_NEXT_TO_INPUT=false

while [[ $# -gt 0 ]]; do
    case "$1" in
    -l | --language)
        LANGUAGE="$2"
        shift 2
        ;;
    -m | --model)
        MODEL="$2"
        shift 2
        ;;
    --md)
        MD_NEXT_TO_INPUT=true
        shift
        ;;
    -o | --output)
        MD_OUTPUT="$2"
        shift 2
        ;;
    -h | --help)
        show_help
        exit 0
        ;;
    -*) die "Unknown option: $1" ;;
    *)
        [[ -z "$INPUT" ]] || die "Only one file at a time"
        INPUT="$1"
        shift
        ;;
    esac
done

[[ -n "$INPUT" ]] || {
    show_help
    exit 2
}
[[ -f "$INPUT" ]] || die "Not a file: $INPUT"
[[ -x "$HEX" ]] || die "Hex not found at $HEX"

if [[ -z "$MD_OUTPUT" ]] && $MD_NEXT_TO_INPUT; then
    MD_OUTPUT="${INPUT%.*}.md"
fi

[[ -n "$LANGUAGE" ]] || LANGUAGE="$(ask_language)"
[[ -n "$LANGUAGE" ]] || die "No language selected"

ensure_hex_running

wav="$INPUT"
if [[ "$INPUT" != *.[wW][aA][vV] ]]; then
    tmpdir="$(mktemp -d -t transcribe.XXXXXX)"
    trap 'rm -rf "$tmpdir"' EXIT
    wav="$tmpdir/audio.wav"
    convert_to_wav "$INPUT" "$wav"
fi

transcript="$("$HEX" transcribe --model "$MODEL" --language "$LANGUAGE" "$wav")"
printf '%s\n' "$transcript"

[[ -z "$MD_OUTPUT" ]] || write_markdown "$MD_OUTPUT" "$transcript"
