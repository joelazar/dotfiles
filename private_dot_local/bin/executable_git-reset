#!/bin/bash

# Reset git repositories to their default branch (main or master) and drop all local changes
# Usage: git-reset [dir1] [dir2] ...
# If no arguments provided, uses current working directory
#
# Runs in three phases so the slow part (network fetch) is parallel:
#   1. discover repos, ask about local changes (interactive, sequential)
#   2. fetch all repos in parallel
#   3. reset each repo locally (fast)

set -o pipefail

# Check if gum is installed
if ! command -v gum &>/dev/null; then
    echo "Error: gum is not installed. Install it with: brew install gum"
    exit 1
fi

# Number of parallel fetches
JOBS="${GIT_RESET_JOBS:-8}"

# Array of directories - from arguments or current directory
if [[ $# -gt 0 ]]; then
    directories=("$@")
else
    directories=("$(pwd)")
fi

# Function to determine default branch (runs inside the repo)
get_default_branch() {
    local default_branch
    default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    default_branch="${default_branch#origin/}"

    if [[ -z "$default_branch" ]]; then
        if git show-ref --verify --quiet refs/remotes/origin/main; then
            default_branch="main"
        elif git show-ref --verify --quiet refs/remotes/origin/master; then
            default_branch="master"
        else
            default_branch="main" # fallback
        fi
    fi

    echo "$default_branch"
}

# Phase 1: confirm a single repo (runs inside the repo). Returns 0 to proceed.
confirm_repo() {
    local dir="$1"
    local status
    status=$(git status --short 2>/dev/null)
    [[ -z "$status" ]] && return 0

    echo ""
    gum style --foreground 220 "⚠️  $dir has local changes:"
    head -10 <<<"$status"
    local total_changes
    total_changes=$(wc -l <<<"$status" | tr -d ' ')
    if [[ $total_changes -gt 10 ]]; then
        echo "  ... and $((total_changes - 10)) more"
    fi
    echo ""
    if ! gum confirm "Drop local changes and reset to origin/$(get_default_branch)?" </dev/tty; then
        echo "  ⏭️  $dir → skipped"
        return 1
    fi
}

# Phase 2: fetch one repo, write result to a file in $tmpdir. Runs in background.
fetch_repo() {
    local dir="$1" idx="$2"
    if git -C "$dir" fetch origin &>/dev/null; then
        echo "ok" >"$tmpdir/$idx"
    else
        echo "failed" >"$tmpdir/$idx"
    fi
}

# Phase 3: reset one repo locally (runs inside the repo)
reset_repo() {
    local dir="$1"
    local default_branch
    default_branch=$(get_default_branch)

    git reset --hard HEAD &>/dev/null
    git clean -fd &>/dev/null

    if ! git checkout -f "$default_branch" &>/dev/null; then
        echo "  ❌ $dir → checkout $default_branch failed"
        return 1
    fi

    if git reset --hard "origin/$default_branch" &>/dev/null; then
        echo "  ✅ $dir → reset & pulled $default_branch"
    else
        echo "  ❌ $dir → reset to $default_branch failed"
        return 1
    fi
}

# ---- Phase 1: discover repos ----
repos=()
for dir in "${directories[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "❌ $dir → directory does not exist"
        continue
    fi

    if [[ -d "$dir/.git" ]]; then
        repos+=("$(cd "$dir" && pwd)")
    else
        echo "📁 $dir → scanning for git repos..."
        found=0
        while IFS= read -r -d '' subdir; do
            repos+=("$(cd "$(dirname "$subdir")" && pwd)")
            ((found++))
        done < <(find "$dir" -maxdepth 2 -type d -name ".git" -print0)
        if [[ $found -eq 0 ]]; then
            echo "  ❌ no git repositories found"
        else
            echo "  📊 found $found repo(s)"
        fi
    fi
done

[[ ${#repos[@]} -eq 0 ]] && exit 0

# Ask about dirty repos before touching anything
confirmed=()
for dir in "${repos[@]}"; do
    if (cd "$dir" && confirm_repo "$dir"); then
        confirmed+=("$dir")
    fi
done

[[ ${#confirmed[@]} -eq 0 ]] && exit 0

# ---- Phase 2: parallel fetch ----
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

echo ""
echo "⬇️  fetching ${#confirmed[@]} repo(s) ($JOBS in parallel)..."
running=0
for i in "${!confirmed[@]}"; do
    fetch_repo "${confirmed[$i]}" "$i" &
    ((running++))
    if [[ $running -ge $JOBS ]]; then
        wait -n 2>/dev/null || wait
        ((running--))
    fi
done
wait

# ---- Phase 3: local resets ----
echo ""
for i in "${!confirmed[@]}"; do
    dir="${confirmed[$i]}"
    result=$(<"$tmpdir/$i")
    case "$result" in
    ok)
        (cd "$dir" && reset_repo "$dir")
        ;;
    *)
        echo "  ❌ $dir → fetch failed"
        ;;
    esac
done
