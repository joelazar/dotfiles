#!/usr/bin/env bash
# Update herdr on this machine and every enabled saved SSH machine.
#
# herdr update only works for installs made by Herdr's own installer, so this
# script picks the right updater per machine: mise, Homebrew, or a direct install.
#
# Usage: herdr-update-all [--force]
#   --force  Bypass mise's 24h minimum release age when upgrading.

set -Eeuo pipefail

SOURCE_DIR="${SOURCE_DIR:-$(chezmoi source-path 2>/dev/null)}"
SOURCE_DIR="${SOURCE_DIR:-$HOME/.local/share/chezmoi}"
# shellcheck source=/dev/null
. "$SOURCE_DIR/scripts/utils_install"
# shellcheck source=/dev/null
. "$SOURCE_DIR/scripts/utils"

fail() {
    print_error "$1" >&2
    exit 1
}

usage() {
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

force=false
for arg in "$@"; do
    case "$arg" in
    --force) force=true ;;
    -h | --help)
        usage
        exit 0
        ;;
    *) fail "unknown argument: $arg" ;;
    esac
done

# mise holds back releases younger than 24h unless we override the age gate.
mise_force_args() {
    [[ "$force" == true ]] && printf '%s' "--minimum-release-age 0d"
}

update_local() {
    if cmd_exists "mise" && mise list herdr 2>/dev/null | grep -q "^herdr"; then
        # shellcheck disable=SC2046
        mise upgrade herdr $(mise_force_args)
    elif cmd_exists "brew" && brew list --versions herdr >/dev/null 2>&1; then
        brew upgrade herdr
    elif cmd_exists "herdr"; then
        herdr update
    else
        fail "herdr is not installed locally"
    fi
}

remote_update_script() {
    local force_args
    force_args=$(mise_force_args)
    cat <<EOF
set -e
if command -v mise >/dev/null 2>&1 && mise list herdr 2>/dev/null | grep -q '^herdr'; then
    mise upgrade herdr $force_args
elif command -v brew >/dev/null 2>&1 && brew list --versions herdr >/dev/null 2>&1; then
    brew upgrade herdr
elif command -v herdr >/dev/null 2>&1; then
    herdr update
else
    echo 'herdr not found' >&2
    exit 1
fi
EOF
}

herdr_version() {
    herdr --version 2>/dev/null | awk '{print $2}'
}

herdr_version_remote() {
    local target=$1
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$target" 'bash -lc "herdr --version"' 2>/dev/null |
        awk '{print $2}'
}

show_header "herdr update" "Updating herdr locally and on saved SSH machines"

show_section "Local"
update_local
print_success "local herdr $(herdr_version)"

mapfile -t machines < <(herdr machine list --json 2>/dev/null |
    jq -r '.[] | select(.enabled) | "\(.label)\t\(.target)"')

for machine in "${machines[@]}"; do
    [[ -n "$machine" ]] || continue
    label=${machine%%$'\t'*}
    target=${machine#*$'\t'}
    show_section "$label ($target)"
    if ssh -o BatchMode=yes -o ConnectTimeout=10 "$target" bash -ls <<<"$(remote_update_script)"; then
        print_success "$label herdr $(herdr_version_remote "$target")"
    else
        print_warning "could not update $label ($target)"
    fi
done

show_completion "herdr update" "Local and saved SSH machines checked."
