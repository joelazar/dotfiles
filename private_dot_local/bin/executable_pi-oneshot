#!/usr/bin/env bash
# pi-oneshot [pi args...]: run `pi -p` for scripted one-shot generation, isolated
# from session-wide prompt injectors (i-have-adhd/ponytail packages, AGENTS.md,
# skill discovery). Those make models reply with chatty "Next:" refusals instead
# of the raw output a script expects.
set -euo pipefail

# Claude subscription auth lives in an extension; re-add it after -ne.
auth_ext=${PI_ONESHOT_AUTH_EXT:-$HOME/Code/joelazar/pi-claude-code-use/index.ts}

args=(-p --no-session --thinking off -nc -ns -ne)
[[ -f "$auth_ext" ]] && args+=(-e "$auth_ext")

exec pi "${args[@]}" "$@"
