#!/bin/bash

SOURCE_DIR=$(chezmoi source-path)

. "$SOURCE_DIR/scripts/utils_install" &&
    . "$SOURCE_DIR/scripts/utils"

empty_macos_trash() {
    osascript <<'APPLESCRIPT'
try
    tell application "Finder" to empty trash
on error number -128
    -- User canceled. Not fatal.
end try
APPLESCRIPT
}

execute "fish -c 'fish_update_completions'" "Update fish completions"

execute "ai-update" "Update AI tools"

execute "tv update-channels" "Update Television channels"

if command -v save-to-spotify >/dev/null 2>&1; then
    execute "save-to-spotify update" "Update save-to-spotify CLI"
fi

execute "brew cleanup" "Cleanup brew"

update_mason() {
    local script
    script=$(mktemp -t mason-update.XXXXXX.lua)
    trap 'rm -f "$script"' RETURN

    cat >"$script" <<'LUA'
local ok, registry = pcall(require, "mason-registry")
if not ok then
    io.stderr:write("mason-registry not available\n")
    vim.cmd("cquit 1")
    return
end

local pending, refreshed = 0, false

registry.refresh(function()
    for _, pkg in ipairs(registry.get_installed_packages()) do
        local installed = pkg:get_installed_version()
        local ok_latest, latest = pcall(pkg.get_latest_version, pkg)
        if ok_latest and latest and latest ~= installed then
            print(("updating %s: %s -> %s"):format(pkg.name, installed or "?", latest))
            pending = pending + 1
            pkg:install({ version = latest }, function(success, err)
                if not success then
                    io.stderr:write(("failed to update %s: %s\n"):format(pkg.name, tostring(err)))
                end
                pending = pending - 1
            end)
        end
    end
    refreshed = true
end)

-- wait at most 15 minutes for refresh + all updates
vim.wait(900000, function() return refreshed and pending <= 0 end, 200)
vim.cmd("qall!")
LUA

    nvim --headless -c "luafile $script" -c 'qall!'
}
export -f update_mason

execute "update_mason" "Update Neovim Mason packages"

update_herdr_integrations() {
    command -v herdr >/dev/null 2>&1 || return 0

    local line target
    herdr integration status 2>/dev/null | while IFS= read -r line; do
        case "$line" in
        *": not installed"*) continue ;;
        esac
        target=${line%%:*}
        target=${target%% (*}
        [ -n "$target" ] || continue
        echo "reinstalling herdr integration: $target"
        herdr integration install "$target" || true
    done
}
export -f update_herdr_integrations

update_herdr_plugins() {
    command -v herdr >/dev/null 2>&1 || return 0

    local repo
    herdr plugin list 2>/dev/null |
        sed -n 's/.*\[github:\([^]@]*\).*/\1/p' |
        sort -u |
        while IFS= read -r repo; do
            [ -n "$repo" ] || continue
            echo "updating herdr plugin: $repo"
            herdr plugin install "$repo" --yes || true
        done
}
export -f update_herdr_plugins

execute "update_herdr_integrations" "Update Herdr agent integrations"

execute "update_herdr_plugins" "Update Herdr plugins"

ask_for_confirmation "Run Mole?"
if answer_is_yes; then
    mo clean
    mo optimize
fi

execute "backup do" "Backup"

ask_for_confirmation "Empty macOS Trash?"
if answer_is_yes; then
    empty_macos_trash
fi

ask_for_confirmation "Do you want to restart your computer?"
if answer_is_yes; then
    sudo shutdown -r now
fi
