#!/usr/bin/env bash
# Open my daily terminal workspace (Herdr or Ghostty tabs): an Obsidian vault in nvim and gh-dash.
#
# Usage: workspace-tabs
set -euo pipefail

readonly OBSIDIAN_DIR="$HOME/Obsidian"

main() {
	local script_dir
	script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
	local term_tab="$script_dir/term-tab"

	if [[ ! -x $term_tab ]]; then
		echo "workspace-tabs: missing helper: $term_tab" >&2
		exit 69
	fi

	"$term_tab" --title "Obsidian 🟪" "$OBSIDIAN_DIR" nvim .
	"$term_tab" --title "GitHub 🐙" "$HOME" gh dash
}

main "$@"
