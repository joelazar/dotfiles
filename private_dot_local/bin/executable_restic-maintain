#!/usr/bin/env bash
#
# Prune old snapshots from the restic repo in $RESTIC_REPOSITORY.
#
set -Eeuo pipefail

# shellcheck source-path=SCRIPTDIR source=../lib/restic-common.sh
source "$HOME/.local/lib/restic-common.sh"
require_repository_env

forget_old_snapshots() {
    printf '🧠 Forgetting extra backups in "%s"\n' "$RESTIC_REPOSITORY"
    restic unlock
    # Group by host only, otherwise every change to the include list starts a
    # new group whose latest snapshot is kept forever.
    restic forget \
        --retry-lock 3h \
        --group-by host \
        --keep-within-daily 7d \
        --keep-within-weekly 1m \
        --keep-within-monthly 1y \
        --keep-within-yearly 100y \
        --prune \
        "$@"
}

ensure_password
require_volume_mounted
require_repository_exists
forget_old_snapshots "$@"
