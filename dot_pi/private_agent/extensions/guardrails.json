{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.24.0/schema.json",
  "enabled": true,
  "applyBuiltinDefaults": true,
  "onboarding": {
    "completed": true
  },
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": false
  },
  "policies": {
    "rules": [
      {
        "id": "joe-secrets",
        "name": "Credentials and secrets",
        "description": "Migrated from path-policy.json blockedPaths",
        "protection": "noAccess",
        "onlyIfExists": false,
        "blockMessage": "Accessing {file} is not allowed: it may contain secrets or credentials. Explain why you need it and ask the user to act if changes are required.",
        "patterns": [
          {
            "pattern": "**/*.key"
          },
          {
            "pattern": "**/*.p12"
          },
          {
            "pattern": "**/*.pem"
          },
          {
            "pattern": "**/*.pfx"
          },
          {
            "pattern": "**/.aws/**"
          },
          {
            "pattern": "**/.azure/**"
          },
          {
            "pattern": "**/.config/gcloud/**"
          },
          {
            "pattern": "**/.config/gh/hosts.yml"
          },
          {
            "pattern": "**/.env*"
          },
          {
            "pattern": "**/.gem/credentials"
          },
          {
            "pattern": "**/.git-credentials"
          },
          {
            "pattern": "**/.kube/**"
          },
          {
            "pattern": "**/.netrc"
          },
          {
            "pattern": "**/.npmrc"
          },
          {
            "pattern": "**/.pypirc"
          },
          {
            "pattern": "**/.secret*"
          },
          {
            "pattern": "**/.terraform.d/credentials.tfrc.json"
          },
          {
            "pattern": "**/.yarnrc.yml"
          },
          {
            "pattern": "**/Obsidian/journal/**"
          },
          {
            "pattern": "**/credentials/**"
          },
          {
            "pattern": "**/id_ed25519"
          },
          {
            "pattern": "**/id_rsa"
          },
          {
            "pattern": "**/pip.conf"
          },
          {
            "pattern": "**/secrets/**"
          },
          {
            "pattern": "**/vault_password"
          },
          {
            "pattern": "~/.aws/**"
          },
          {
            "pattern": "~/.azure/**"
          },
          {
            "pattern": "~/.codex/auth.json"
          },
          {
            "pattern": "~/.config/exercism/user.json"
          },
          {
            "pattern": "~/.config/gcloud/**"
          },
          {
            "pattern": "~/.config/gcx/config.yaml"
          },
          {
            "pattern": "~/.config/gh/hosts.yml"
          },
          {
            "pattern": "~/.config/github-copilot/**"
          },
          {
            "pattern": "~/.config/gws/**"
          },
          {
            "pattern": "~/.config/pip/pip.conf"
          },
          {
            "pattern": "~/.config/save-to-spotify/**"
          },
          {
            "pattern": "~/.fly/**"
          },
          {
            "pattern": "~/.gem/credentials"
          },
          {
            "pattern": "~/.git-credentials"
          },
          {
            "pattern": "~/.gnupg/**"
          },
          {
            "pattern": "~/.kube/**"
          },
          {
            "pattern": "~/.netrc"
          },
          {
            "pattern": "~/.npmrc"
          },
          {
            "pattern": "~/.pi/**/auth.json"
          },
          {
            "pattern": "~/.pypirc"
          },
          {
            "pattern": "~/.ssh/**"
          },
          {
            "pattern": "~/.terraform.d/credentials.tfrc.json"
          },
          {
            "pattern": "~/.config/op/**"
          },
          {
            "pattern": "~/.config/sops/**"
          },
          {
            "pattern": "~/*.gpg"
          },
          {
            "pattern": "~/.gpg-agent.conf"
          },
          {
            "pattern": "~/.local/share/fish/fish_history"
          },
          {
            "pattern": "~/.zsh_history"
          },
          {
            "pattern": "~/.bash_history"
          },
          {
            "pattern": "~/.local/share/atuin/**"
          },
          {
            "pattern": "~/.docker/config.json"
          }
        ],
        "allowedPatterns": [
          {
            "pattern": "~/.ssh/*.pub"
          },
          {
            "pattern": ".env.example"
          },
          {
            "pattern": ".env.sample"
          },
          {
            "pattern": ".env.template"
          },
          {
            "pattern": ".env.test"
          },
          {
            "pattern": ".envrc.template"
          },
          {
            "pattern": ".envrc.example"
          },
          {
            "pattern": "*.example.env"
          },
          {
            "pattern": "~/.ssh/config"
          },
          {
            "pattern": "~/.aws/config"
          }
        ]
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "patterns": [
      {
        "pattern": "chmod\\b.*o\\+w",
        "description": "world-writable permission (o+w)",
        "regex": true
      },
      {
        "pattern": "(psql|pgcli|mysql|mariadb|sqlite3|duckdb|sqlcmd|clickhouse-client)\\b[\\s\\S]*\\b(DROP\\s+(TABLE|DATABASE|SCHEMA|VIEW|INDEX|ROLE|USER|EXTENSION)|TRUNCATE(\\s+TABLE)?|DELETE\\s+FROM)\\b",
        "description": "destructive SQL statement",
        "regex": true
      },
      {
        "pattern": "git\\s+clean\\b.*-[a-z]*f",
        "description": "git clean (removes untracked files)",
        "regex": true
      },
      {
        "pattern": "git\\s+reset\\b.*--hard",
        "description": "git reset --hard (loses uncommitted changes)",
        "regex": true
      },
      {
        "pattern": "find\\b.*-delete\\b",
        "description": "file deletion (find -delete)",
        "regex": true
      },
      {
        "pattern": "find\\b.*-exec\\s+rm\\b",
        "description": "file deletion (find -exec rm)",
        "regex": true
      },
      {
        "pattern": "(curl|wget)\\b[^|]*\\|\\s*(ba)?sh\\b",
        "description": "remote code execution (pipe to shell)",
        "regex": true
      },
      {
        "pattern": ">\\s*/dev/sd[a-z]",
        "description": "write to raw block device",
        "regex": true
      },
      {
        "pattern": "(^|[;&|(\\x60'\"\\n]|\\$\\()\\s*(\\w+=\\S*\\s+)*((sudo|env|exec|command|time|nohup)\\s+)*(\\S*/)?(ssh|scp|sftp|mosh|autossh)(\\s|$)",
        "description": "remote shell / file transfer (ssh, scp, sftp, mosh)",
        "regex": true
      },
      {
        "pattern": "(^|[;&|(\\x60'\"\\n]|\\$\\()\\s*(\\w+=\\S*\\s+)*((sudo|env|exec|command|time|nohup)\\s+)*(\\S*/)?rsync\\s[^;&|\\n]*?(^|\\s)[\\w.@-]+:",
        "description": "rsync to/from a remote host",
        "regex": true
      }
    ],
    "autoDenyPatterns": [
      {
        "pattern": "rm\\s+(-[a-zA-Z]+\\s+)*(/|~|\\$HOME|\\$\\{HOME\\})(\\s|$)",
        "description": "catastrophic rm target (/ or home)",
        "regex": true,
        "terminate": true
      },
      {
        "pattern": "rm\\s+(-[a-zA-Z]+\\s+)*(/|~|\\$HOME|\\$\\{HOME\\}|\\.|\\.\\.)/\\*",
        "description": "catastrophic rm wildcard target",
        "regex": true,
        "terminate": true
      },
      {
        "pattern": "\\b(ssh|scp|rsync|sftp)\\b[\\s\\S]*(^|[\\s'\"/=:*])\\.env(rc)?(?!\\.(example|sample|template|test)\\b)(?=$|[\\s'\"./*;&|)])",
        "description": "reading .env files on a remote host is not allowed: they may contain secrets. Explain why you need it and ask the user to act instead.",
        "regex": true
      },
      {
        "pattern": "(^|[;&|(\\x60'\"\\s])(echo|printf)\\b(?![^\\n;&|]*\\|(\\s*(shasum|sha\\d+sum|md5sum|md5|wc)\\b|[^\\n;&]*--password-stdin))[^\\n;&|\\[]*\\$\\{?(?![#!])\\w*(TOKEN|SECRET|PASSW(OR)?D|PASSPHRASE|API_?KEY|PRIVATE_KEY|ACCESS_KEY|CREDENTIALS?|DATABASE_URL|DB_URL|REDIS_URL|DSN|CONNECTION_STRING)\\w*(?!\\w|:?\\+)",
        "description": "printing a secret environment variable. Check presence with ${VAR:+set} or length with ${#VAR} instead, and pass it to commands without echoing it.",
        "regex": true
      },
      {
        "pattern": "(^|[;&|(\\x60'\"\\s])printenv\\s+\\w*(TOKEN|SECRET|PASSW(OR)?D|PASSPHRASE|API_?KEY|PRIVATE_KEY|ACCESS_KEY|CREDENTIALS?|DATABASE_URL|DB_URL|REDIS_URL|DSN|CONNECTION_STRING)\\w*(?!\\w)(?!\\s*\\|\\s*(shasum|sha\\d+sum|md5sum|md5|wc)\\b)",
        "description": "printing a secret environment variable (locally or via exec/ssh). Pipe to wc -c if you only need to know it is set.",
        "regex": true
      },
      {
        "pattern": "(^|[;&(\\x60\\n]|\\|\\s|\\s)(printenv|env)\\s*($|[;&)\\x60'\"\\n]|\\|(?!\\s*(cut\\s+-d\\s*['\"]?=['\"]?\\s+-f\\s*1|sed\\s+(-E\\s+)?['\"]?s/=\\.?\\*|(rg|grep)\\s+['\"]?\\^PI_['\"]?(\\s|$))))",
        "description": "dumping the whole environment exposes secrets. List names only with `env | cut -d= -f1`, or check one var with ${VAR:+set}.",
        "regex": true
      },
      {
        "pattern": "/proc/[^/\\n]*/environ",
        "description": "reading a process environment (/proc/*/environ) exposes secrets.",
        "regex": true
      }
    ],
    "allowedPatterns": [
      {
        "pattern": "^\\s*rm\\s+(?:-[rRfv]+\\s+)+(?:/private)?/tmp/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?(?:\\s+(?:/private)?/tmp/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?)*\\s*;?\\s*$",
        "description": "rm -rf confined to /tmp scratch paths",
        "regex": true
      },
      {
        "pattern": "^\\s*rm\\s+(?:-[rRfv]+\\s+)+/var/folders/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?(?:\\s+/var/folders/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?)*\\s*;?\\s*$",
        "description": "rm -rf confined to macOS TMPDIR (/var/folders)",
        "regex": true
      },
      {
        "pattern": "^\\s*rm\\s+(?:-[rRfv]+\\s+)+(?:\\./)?(?:(?!\\.\\.?(?:/|$))[\\w.@%+=-]+/)*(?:node_modules|dist|target|\\.venv|__pycache__)/?(?:\\s+(?:\\./)?(?:(?!\\.\\.?(?:/|$))[\\w.@%+=-]+/)*(?:node_modules|dist|target|\\.venv|__pycache__)/?)*\\s*;?\\s*$",
        "description": "rm -rf of regenerable build artifacts",
        "regex": true
      },
      {
        "pattern": "^\\s*rm\\s+(?:-[rRfv]+\\s+)+(?:/Users/joelazar|~|\\$HOME|\\$\\{HOME\\})/go/pkg/mod/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?(?:\\s+(?:/Users/joelazar|~|\\$HOME|\\$\\{HOME\\})/go/pkg/mod/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+(?:/(?!\\.\\.?(?:/|$))[\\w.@%+=-]+)*/?)*\\s*;?\\s*$",
        "description": "rm -rf of Go module cache (regenerable)",
        "regex": true
      }
    ]
  },
  "version": "0.24.0"
}
