{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "syncClaudeAiSkills": false,
  "env": {
    "USE_BUILTIN_RIPGREP": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "AWS_PAGER": ""
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker run:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(go:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(npm run build:*)",
      "Bash(rg:*)",
      "Bash(sqlc:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Edit(~/Code/**)",
      "Glob",
      "Read(~/Code/**)",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(dd * of=/dev/*)",
      "Bash(diskutil apfs changePassphrase *)",
      "Bash(diskutil apfs decryptVolume *)",
      "Bash(diskutil apfs deleteContainer *)",
      "Bash(diskutil apfs deleteSnapshot *)",
      "Bash(diskutil apfs deleteVolume *)",
      "Bash(diskutil apfs deleteVolumeGroup *)",
      "Bash(diskutil apfs eraseVolume *)",
      "Bash(diskutil appleRAID *)",
      "Bash(diskutil coreStorage *)",
      "Bash(diskutil cs *)",
      "Bash(diskutil disableJournal *)",
      "Bash(diskutil disableOwnership *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil partitionDisk *)",
      "Bash(diskutil randomDisk *)",
      "Bash(diskutil reformat *)",
      "Bash(diskutil resetFusion *)",
      "Bash(diskutil zeroDisk *)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf $PAI_DIR)",
      "Bash(rm -rf $PAI_HOME)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~)",
      "Bash(sudo rm -rf ~/)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/.aws/**)",
      "Edit(**/.azure/**)",
      "Edit(**/.config/gcloud/**)",
      "Edit(**/.config/gh/hosts.yml)",
      "Edit(**/.env*)",
      "Edit(**/.gem/credentials)",
      "Edit(**/.git-credentials)",
      "Edit(**/.kube/**)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.secret*)",
      "Edit(**/.terraform.d/credentials.tfrc.json)",
      "Edit(**/.yarnrc.yml)",
      "Edit(**/Obsidian/journal/**)",
      "Edit(**/credentials/**)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_rsa)",
      "Edit(**/pip.conf)",
      "Edit(**/secrets/**)",
      "Edit(**/vault_password)",
      "Edit(~/*.gpg)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.codex/auth.json)",
      "Edit(~/.config/exercism/user.json)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.config/gcx/config.yaml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Edit(~/.config/github-copilot/**)",
      "Edit(~/.config/gws/**)",
      "Edit(~/.config/op/**)",
      "Edit(~/.config/pip/pip.conf)",
      "Edit(~/.config/save-to-spotify/**)",
      "Edit(~/.config/sops/**)",
      "Edit(~/.fly/**)",
      "Edit(~/.gem/credentials)",
      "Edit(~/.git-credentials)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.gpg-agent.conf)",
      "Edit(~/.kube/**)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.pi/**/auth.json)",
      "Edit(~/.pypirc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.terraform.d/credentials.tfrc.json)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.aws/**)",
      "Read(**/.azure/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(**/.env*)",
      "Read(**/.gem/credentials)",
      "Read(**/.git-credentials)",
      "Read(**/.kube/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.secret*)",
      "Read(**/.ssh/**)",
      "Read(**/.terraform.d/credentials.tfrc.json)",
      "Read(**/.yarnrc.yml)",
      "Read(**/Obsidian/journal/**)",
      "Read(**/credentials/**)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/pip.conf)",
      "Read(**/secrets/**)",
      "Read(**/vault_password)",
      "Read(~/*.gpg)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/exercism/user.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gcx/config.yaml)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.config/gws/**)",
      "Read(~/.config/op/**)",
      "Read(~/.config/pip/pip.conf)",
      "Read(~/.config/save-to-spotify/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.fly/**)",
      "Read(~/.gem/credentials)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.gpg-agent.conf)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pi/**/auth.json)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Read(~/.terraform.d/credentials.tfrc.json)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "sonnet"
  ],
  "skillOverrides": {
    "bro": "off",
    "explain-diff-html": "off",
    "grilling": "off",
    "humanizer": "off",
    "improve-codebase-architecture": "off",
    "pdf": "off",
    "save-to-spotify": "off",
    "web-research": "off",
    "writing-for-agents": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/joelazar/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "cowork-plugin-management@synced": false,
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [
        "~/.config/colima/default/docker.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/Go/pkg/mod",
        "~/.npm",
        "~/.cache"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "docker compose *",
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git clone *"
    ]
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "timeFormat": "24-hour",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Never force-push to main or master",
      "Never run chezmoi apply without naming specific targets"
    ],
    "hard_deny": [
      "$defaults",
      "Never erase, partition, reformat, or wipe disks, APFS containers, volumes, or snapshots (diskutil erase/partition/delete, mkfs, newfs, dd to a device)",
      "Never recursively delete the home directory, the filesystem root, ~/Code, or ~/.local/share/chezmoi"
    ],
    "environment": [
      "$defaults",
      "Personal macOS development machine owned by Joe Lazar. Primary use: software development (Go, TypeScript, shell) and dotfiles maintenance",
      "Source control: github.com/joelazar and all repos under it",
      "Dotfiles are managed by chezmoi; the source directory is ~/.local/share/chezmoi and changes reach the live system only via chezmoi apply"
    ]
  },
  "voiceEnabled": false
}
