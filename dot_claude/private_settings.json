{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "syncClaudeAiSkills": false,
  "env": {
    "USE_BUILTIN_RIPGREP": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker run:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(go:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(npm run build:*)",
      "Bash(rg:*)",
      "Bash(sqlc:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Edit(~/Code/**)",
      "Glob",
      "Read(~/Code/**)",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(dd * of=/dev/*)",
      "Bash(diskutil apfs changePassphrase *)",
      "Bash(diskutil apfs decryptVolume *)",
      "Bash(diskutil apfs deleteContainer *)",
      "Bash(diskutil apfs deleteSnapshot *)",
      "Bash(diskutil apfs deleteVolume *)",
      "Bash(diskutil apfs deleteVolumeGroup *)",
      "Bash(diskutil apfs eraseVolume *)",
      "Bash(diskutil appleRAID *)",
      "Bash(diskutil coreStorage *)",
      "Bash(diskutil cs *)",
      "Bash(diskutil disableJournal *)",
      "Bash(diskutil disableOwnership *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil partitionDisk *)",
      "Bash(diskutil randomDisk *)",
      "Bash(diskutil reformat *)",
      "Bash(diskutil resetFusion *)",
      "Bash(diskutil zeroDisk *)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf $PAI_DIR)",
      "Bash(rm -rf $PAI_HOME)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~)",
      "Bash(sudo rm -rf ~/)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.aws/**)",
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Read(**/credentials/**)",
      "Read(**/secrets/**)"
    ],
    "defaultMode": "auto",
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/joelazar/skills/tldraw-offline/inject-server-context.sh' SubagentStart"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/joelazar/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "timeFormat": "24-hour",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false,
  "outputStyle": "Concise",
  "fallbackModel": [
    "sonnet"
  ],
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Personal macOS development machine owned by Joe Lazar. Primary use: software development (Go, TypeScript, shell) and dotfiles maintenance",
      "Source control: github.com/joelazar and all repos under it",
      "Dotfiles are managed by chezmoi; the source directory is ~/.local/share/chezmoi and changes reach the live system only via chezmoi apply"
    ],
    "soft_deny": [
      "$defaults",
      "Never force-push to main or master",
      "Never run chezmoi apply without naming specific targets"
    ],
    "hard_deny": [
      "$defaults",
      "Never erase, partition, reformat, or wipe disks, APFS containers, volumes, or snapshots (diskutil erase/partition/delete, mkfs, newfs, dd to a device)",
      "Never recursively delete the home directory, the filesystem root, ~/Code, or ~/.local/share/chezmoi"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "docker *",
      "docker compose *",
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git clone *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/go/pkg/mod",
        "~/.npm",
        "~/.cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "registry.npmjs.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
